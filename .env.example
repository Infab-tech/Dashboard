# Copy this file to .env.local and fill in real values. Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — direct Postgres connection string (Supabase project settings > Database)
DATABASE_URL=

# Server-only — full-privilege key, bypasses Row Level Security. NEVER expose to the client.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
