generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String     @id @default(uuid())
  code           String?    @unique
  supabaseAuthId String     @unique
  name           String
  email          String     @unique
  role           UserRole   @default(ADMIN)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  dailyLogs      DailyLog[]
  personRecord   Person?
}

model Project {
  id               String             @id @default(uuid())
  code             String?            @unique
  name             String
  description      String?
  status           ProjectStatus      @default(PLANNED)
  startDate        DateTime?
  endDate          DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  projectLeadId    String?
  assets           Asset[]
  dailyLogs        DailyLog[]
  financials       FinancialEntry[]
  inventoryItems   InventoryItem[]
  milestones       Milestone[]
  people           PersonProject[]
  procurements     ProcurementOrder[]
  Person           Person?            @relation(fields: [projectLeadId], references: [id])
  TaskHistoryEvent TaskHistoryEvent[]
  tasks            WorkflowTask[]
}

model WorkflowTask {
  id                                                     String         @id @default(uuid())
  code                                                   String?        @unique
  projectId                                              String
  title                                                  String
  description                                            String?
  status                                                 TaskStatus     @default(TODO)
  assignedToId                                           String?
  dependsOnId                                            String?
  dueDate                                                DateTime?
  createdAt                                              DateTime       @default(now())
  updatedAt                                              DateTime       @updatedAt
  delayReason                                            String?
  notes                                                  String?
  parentId                                               String?
  percentComplete                                        Int            @default(0)
  startDate                                              DateTime?
  assignedTo                                             Person?        @relation(fields: [assignedToId], references: [id])
  dependsOn                                              WorkflowTask?  @relation("TaskDependency", fields: [dependsOnId], references: [id])
  blockedTasks                                           WorkflowTask[] @relation("TaskDependency")
  WorkflowTask_WorkflowTask_parentIdToWorkflowTask       WorkflowTask?  @relation("WorkflowTask_parentIdToWorkflowTask", fields: [parentId], references: [id])
  other_WorkflowTask_WorkflowTask_parentIdToWorkflowTask WorkflowTask[] @relation("WorkflowTask_parentIdToWorkflowTask")
  project                                                Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Milestone {
  id          String    @id @default(uuid())
  code        String?   @unique
  projectId   String
  title       String
  dueDate     DateTime
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model FinancialEntry {
  id          String             @id @default(uuid())
  code        String?            @unique
  projectId   String
  type        FinancialEntryType
  category    String
  amount      Decimal
  currency    String             @default("INR")
  entryDate   DateTime
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model InventoryItem {
  id              String          @id @default(uuid())
  code            String?         @unique
  projectId       String?
  name            String
  globalCategory  GlobalCategory?
  boiCategory     BOICategory?
  vendorId        String?
  dateOfPurchase  DateTime?
  referenceNumber String?
  description     String?
  poNumber        String?
  quantity        Int             @default(0)
  unit            String?
  location        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  project         Project?        @relation(fields: [projectId], references: [id])
  vendor          Vendor?         @relation(fields: [vendorId], references: [id])
}

model Vendor {
  id             String             @id @default(uuid())
  code           String?            @unique
  name           String
  category       String?
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  procurements   ProcurementOrder[]
  inventoryItems InventoryItem[]
}

model ProcurementOrder {
  id           String            @id @default(uuid())
  code         String?           @unique
  projectId    String
  vendorId     String
  itemsSummary String
  status       ProcurementStatus @default(REQUESTED)
  amount       Decimal?
  orderedAt    DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor       Vendor            @relation(fields: [vendorId], references: [id])
}

model DailyLog {
  id        String   @id @default(uuid())
  code      String?  @unique
  projectId String
  authorId  String
  logDate   DateTime
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id])
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Asset {
  id           String      @id @default(uuid())
  code         String?     @unique
  projectId    String?
  name         String
  category     String?
  status       AssetStatus @default(IN_STORAGE)
  assignedToId String?
  purchaseDate DateTime?
  value        Decimal?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  assignedTo   Person?     @relation(fields: [assignedToId], references: [id])
  project      Project?    @relation(fields: [projectId], references: [id])
}

model Person {
  id             String          @id @default(uuid())
  code           String?         @unique
  userId         String?         @unique
  name           String
  title          String?
  managerId      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  assignedAssets Asset[]
  manager        Person?         @relation("PersonHierarchy", fields: [managerId], references: [id])
  reports        Person[]        @relation("PersonHierarchy")
  user           User?           @relation(fields: [userId], references: [id])
  projects       PersonProject[]
  Project        Project[]
  assignedTasks  WorkflowTask[]
}

model PersonProject {
  id            String  @id @default(uuid())
  personId      String
  projectId     String
  roleOnProject String?
  person        Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([personId, projectId])
}

model TaskHistoryEvent {
  id            String               @id
  projectId     String
  taskTitlePath String
  eventType     TaskHistoryEventType
  fromStatus    TaskStatus?
  toStatus      TaskStatus?
  occurredOn    DateTime
  createdAt     DateTime             @default(now())
  Project       Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, occurredOn])
}

enum UserRole {
  ADMIN
}

enum ProjectStatus {
  PLANNED
  ONGOING
  ON_HOLD
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  DELAYED
}

enum FinancialEntryType {
  INCOME
  EXPENSE
}

enum ProcurementStatus {
  REQUESTED
  ORDERED
  RECEIVED
  CANCELLED
}

enum AssetStatus {
  IN_USE
  IN_STORAGE
  UNDER_MAINTENANCE
  RETIRED
}

enum GlobalCategory {
  RAW_MATERIALS
  BOI
  CONSUMABLES
  FABRICATED
}

enum BOICategory {
  ELECTRICAL
  ELECTRONICS
  MECHANICAL
}

enum TaskHistoryEventType {
  CREATED
  STATUS_CHANGED
  COMPLETED
  REMOVED
}
